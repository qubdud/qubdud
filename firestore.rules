rules_version = '2';

// QUBDUD — reguły Firestore.
// Zasada: anonim (Firebase anonymous auth) widzi WYŁĄCZNIE prezentacje (promos).
// Wszystko inne wymaga pełnego konta. Zapis przepuszcza tylko te pola i przejścia,
// które robi apka; zapisy krzyżowe (firma↔klient) wyłącznie między stronami relacji.
// Cloud Functions działają z Admin SDK i omijają te reguły.
service cloud.firestore {
  match /databases/{database}/documents {

    function anyAuth() {
      return request.auth != null;
    }
    function signedIn() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function onlyKeys(keys) {
      return changedKeys().hasOnly(keys);
    }
    function validLocation(l) {
      return l is map && l.keys().hasOnly(['lat', 'lng']) && l.lat is number && l.lng is number;
    }

    // ── config/app.minBuild: blokada starych wersji, czytana przed logowaniem; zapis tylko z konsoli ──
    match /config/{docId} {
      allow get: if true;
    }

    // ── prezentacje firm: anonim może oglądać ──
    match /promos/{promoId} {
      allow read: if anyAuth();
      allow create: if signedIn() && validPromo(request.resource.data);
      // właściciel przepina lokalizację; każdy zalogowany dolicza jedno wyświetlenie
      allow update: if (isMe(resource.data.userId) && onlyKeys(['location'])
              && validLocation(request.resource.data.location))
          || (signedIn() && onlyKeys(['views'])
              && request.resource.data.views == resource.data.get('views', 0) + 1);
      allow delete: if isMe(resource.data.userId);

      function validPromo(d) {
        return d.keys().hasOnly(['userId', 'category', 'sector', 'location', 'fileUrl',
                'thumbUrl', 'fileName', 'timestamp', 'description', 'companyName'])
            && d.userId == request.auth.uid
            && d.category is string && d.sector is string && validLocation(d.location)
            && d.fileUrl is string && d.thumbUrl is string && d.fileName is string
            && d.timestamp == request.time
            && d.description is string && d.companyName is string;
      }
    }

    // ── użytkownicy i firmy ──
    match /users/{userId} {
      // apka czyta profile pojedynczo; listowanie kolekcji ujawniałoby dane wszystkich
      allow get: if signedIn();
      allow list: if false;
      allow create: if isMe(userId) && validNewUser(request.resource.data);
      // rola (firma/isCompany), NIP, e-mail, zgody i pola systemowe są niezmienne
      allow update: if isMe(userId)
          && onlyKeys(['firstName', 'lastName', 'phone', 'bio', 'companyName', 'companyCity',
                       'companyAddress', 'companyLocation', 'www', 'contactEmail', 'showPhone',
                       'showAddress', 'slotsInfo', 'fcmTokens'])
          // telefon klienta jest tylko w private/contact (jawny ma wyłącznie firma)
          && (!changedKeys().hasAny(['phone'])
              || resource.data.get('firma', resource.data.get('isCompany', false)) == true
              || request.resource.data.phone == '');
      allow delete: if false;

      function validNewUser(d) {
        return d.keys().hasOnly(['email', 'firstName', 'lastName', 'phone', 'bio', 'isCompany',
                'firma', 'nip', 'companyName', 'companyCategory', 'companySector', 'companyCity',
                'companyLocation', 'companyAddress', 'consents', 'createdAt'])
            && d.email is string && d.firstName is string && d.lastName is string
            && d.phone is string
            && d.firma is bool && d.isCompany == d.firma
            && d.consents.keys().hasOnly(['terms', 'rodo', 'acceptedAt'])
            && d.consents.terms == true && d.consents.rodo == true
            && d.consents.acceptedAt == request.time
            && d.createdAt == request.time
            && (d.firma
                ? d.nip is string && d.nip.size() == 10
                    && d.companyName is string && d.companyName.size() > 0
                    && d.companyCategory is string && d.companySector is string
                    && validLocation(d.companyLocation)
                : !d.keys().hasAny(['nip', 'companyName', 'companyCategory', 'companySector',
                                    'companyCity', 'companyLocation', 'companyAddress']));
      }

      // sloty kalendarza: firma zarządza, klient tylko rezerwuje wolny/wygasły i odwołuje swój
      match /slots/{slotId} {
        allow read: if signedIn();
        allow create: if isMe(userId)
            && request.resource.data.keys().hasOnly(['start', 'durationMin'])
            && request.resource.data.start is timestamp;
        allow delete: if isMe(userId);
        allow update: if isMe(userId) || clientBooks() || clientCancels();

        // wolny = brak pola status (świeży slot) albo 'free'; żółta rezerwacja wygasa po godzinie
        function clientBooks() {
          let d = request.resource.data;
          return signedIn()
              && onlyKeys(['status', 'bookedBy', 'bookedByName', 'bookedAt'])
              && (resource.data.get('status', 'free') in ['free', 'rejected']
                  || (resource.data.status == 'pending'
                      && resource.data.bookedAt < request.time - duration.value(60, 'm')))
              && resource.data.start > request.time
              && d.status == 'pending' && d.bookedBy == request.auth.uid
              && d.bookedByName is string && d.bookedAt == request.time;
        }
        function clientCancels() {
          let d = request.resource.data;
          return signedIn()
              && resource.data.get('bookedBy', '') == request.auth.uid
              && resource.data.get('status', 'free') in ['pending', 'accepted']
              && onlyKeys(['status', 'bookedBy', 'bookedByName', 'releasedBy'])
              && d.status == 'free' && d.bookedBy == '' && d.bookedByName == ''
              && d.releasedBy == 'user';
        }
      }

      // kopia rezerwacji klienta (id = {companyId}_{slotId}). Klient zapisuje tylko 'pending';
      // decyzję ('accepted' = prawo do recenzji, 'rejected', 'cancelled') wpisuje firma
      // w transakcji ze swoim slotem zajętym przez tego klienta.
      match /myBookings/{bookingId} {
        allow read, delete: if isMe(userId);
        allow create, update: if isMe(userId) && clientBookingOk();
        allow create: if companyDecisionOk(request.resource.data.keys());
        allow update: if companyDecisionOk(changedKeys());

        function clientBookingOk() {
          let d = request.resource.data;
          return d.keys().hasOnly(['companyId', 'companyName', 'slotId', 'start', 'status', 'bookedAt'])
              && bookingId == d.companyId + '_' + d.slotId
              && d.status == 'pending' && d.bookedAt == request.time;
        }
        function companyDecisionOk(keys) {
          let d = request.resource.data;
          return signedIn()
              && keys.hasOnly(['companyId', 'companyName', 'slotId', 'start', 'status', 'decidedAt'])
              && d.companyId == request.auth.uid
              && bookingId == request.auth.uid + '_' + d.slotId
              && d.status in ['accepted', 'rejected', 'cancelled']
              && d.decidedAt == request.time
              && get(/databases/$(database)/documents/users/$(request.auth.uid)/slots/$(d.slotId)).data.bookedBy == userId;
        }
      }

      // relacje klient↔firma: tworzy klient (oferta, rezerwacja, prośba o kontakt),
      // firma przy odrzuceniu/usunięciu terminu tylko zdejmuje slot albo kasuje relację.
      // 'requestId' w update (apka kasuje stare pole) — EXPIRES: po migrate_relation_request_id.js --apply
      function onlySlotRemoved() {
        return onlyKeys(['slotIds'])
            && request.resource.data.get('slotIds', []).toSet()
                   .difference(resource.data.get('slotIds', []).toSet()).size() == 0;
      }
      match /clients/{clientId} {
        allow list: if isMe(userId);
        allow get, delete: if isMe(userId) || isMe(clientId);
        allow create: if isMe(clientId)
            && request.resource.data.keys().hasOnly(['userId', 'name', 'addedAt', 'lastAt',
                   'requestIds', 'slotIds', 'contactRequestId'])
            && request.resource.data.userId == clientId;
        allow update: if (isMe(clientId)
                && onlyKeys(['userId', 'name', 'addedAt', 'lastAt', 'requestIds', 'requestId',
                             'slotIds', 'contactRequestId'])
                && request.resource.data.get('userId', clientId) == clientId)
            || (isMe(userId) && onlySlotRemoved());
      }
      match /myCompanies/{companyId} {
        allow list: if isMe(userId);
        allow get, delete: if isMe(userId) || isMe(companyId);
        allow create: if isMe(userId)
            && request.resource.data.keys().hasOnly(['companyId', 'name', 'addedAt', 'lastAt',
                   'requestIds', 'slotIds', 'contactRequestId'])
            && request.resource.data.companyId == companyId;
        allow update: if (isMe(userId)
                && onlyKeys(['companyId', 'name', 'addedAt', 'lastAt', 'requestIds', 'requestId',
                             'slotIds', 'contactRequestId'])
                && request.resource.data.get('companyId', companyId) == companyId)
            || (isMe(companyId) && onlySlotRemoved());
      }

      // prywatne dane właściciela konta
      match /clientNotes/{noteId} {
        allow read, write: if isMe(userId);
      }
      // zablokowani użytkownicy (wymóg Google Play dla treści użytkowników)
      match /blocked/{otherId} {
        allow read, delete: if isMe(userId);
        allow create: if isMe(userId) && otherId != userId
            && request.resource.data.keys().hasOnly(['createdAt'])
            && request.resource.data.createdAt == request.time;
      }
      match /favoritePromos/{promoId} {
        allow read, write: if isMe(userId);
      }
      match /skippedRequests/{requestId} {
        allow read, write: if isMe(userId);
      }
      match /contacts/{contactId} {
        allow read, write: if isMe(userId);
      }
      // telefon i e-mail konta (RODO): właściciel oraz firma, u której ten użytkownik jest
      // klientem z przyjętej oferty albo rezerwacji — users/{firma}/clients/{uid} zakłada wyłącznie
      // klient, firma może go tylko usunąć. Prośba o kontakt daje firmie tylko numer z prośby.
      // Telefon firmy jest jawny w users/{uid}.
      match /private/{docId} {
        allow get: if isMe(userId)
            || (docId == 'contact' && signedIn()
                && relOk(get(/databases/$(database)/documents/users/$(request.auth.uid)/clients/$(userId)).data));
        allow list: if false;
        allow create: if isMe(userId) && docId == 'contact' && contactOk(request.resource.data);
        // e-mail logowania jest niezmienny, jak w users/{uid}
        allow update: if isMe(userId) && docId == 'contact' && onlyKeys(['phone'])
            && contactOk(request.resource.data);
        allow delete: if false;

        function relOk(r) {
          return r.get('requestIds', []).size() > 0 || r.get('slotIds', []).size() > 0
              // EXPIRES (pole requestId): po migrate_relation_request_id.js --apply
              || r.get('requestId', '') != '';
        }
        function contactOk(d) {
          return d.keys().hasOnly(['email', 'phone'])
              && d.get('email', '') is string
              && d.get('email', '').lower() in ['', request.auth.token.get('email', '').lower()]
              && d.get('phone', '') is string && d.get('phone', '').size() <= 50;
        }
      }
    }

    // ── prośby o telefon (id = {companyId}_{userId}): klient tworzy/ponawia, firma oznacza załatwione ──
    match /contactRequests/{id} {
      // odczyt nieistniejącej prośby to zwykłe „jeszcze nie prosiłem”
      allow get: if signedIn()
          && (resource == null
              || resource.data.userId == request.auth.uid
              || resource.data.companyId == request.auth.uid);
      allow create: if signedIn() && contactRequestOk();
      allow update: if (isMe(resource.data.userId) && contactRequestOk())
          || (isMe(resource.data.companyId) && onlyKeys(['status', 'doneAt'])
              && request.resource.data.status == 'done'
              && request.resource.data.doneAt == request.time);
      allow delete: if false;

      function contactRequestOk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['userId', 'companyId', 'userName', 'companyName', 'phone',
                'note', 'status', 'createdAt', 'doneAt'])
            && d.userId == request.auth.uid && d.companyId != request.auth.uid
            && id == d.companyId + '_' + request.auth.uid
            && d.userName is string && d.companyName is string
            && d.phone is string && d.note is string
            && d.status == 'pending' && d.createdAt == request.time && d.doneAt == null;
      }
    }

    // ── stary opis firmy (kolekcja `profile`), apka już nie zapisuje ──
    // EXPIRES: po migrate_profile_bio.js --apply i usunięciu kolekcji `profile`
    match /profile/{userId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ── zgłoszenia i oferty ──
    // Przejęcie (takenBy) ustawia tylko właściciel razem z akceptacją oferty tej firmy;
    // firma realizująca zmienia wyłącznie realizationStatus (zdjęcia czekają / wycofane);
    // 'approved' (prawo do recenzji, licznik zleceń) tylko z 'pending' decyzją właściciela.
    match /requests/{requestId} {
      allow read: if signedIn();
      // id usuniętego zgłoszenia nie wraca, dopóki cleanupDeletedRequest nie zabierze jego private/location
      allow create: if signedIn() && validNewRequest(request.resource.data)
          && !exists(/databases/$(database)/documents/requests/$(requestId)/private/location);
      allow update: if isMe(resource.data.userId) && ownerUpdate();
      allow update: if isMe(resource.data.takenBy) && takerUpdate();
      allow delete: if isMe(resource.data.userId);

      function validNewRequest(d) {
        return d.keys().hasOnly(['userId', 'category', 'sector', 'location', 'city', 'fileUrl',
                'thumbUrl', 'fileName', 'mediaType', 'timestamp', 'is24', 'description', 'status',
                'takenBy', 'takenByName', 'confirmedByCompany', 'confirmedByUser',
                'timing', 'budget', 'answers'])
            && (!('timing' in d) || d.timing in ['asap', 'week', 'month', 'flexible'])
            && (!('budget' in d) || (d.budget is int && d.budget >= 0 && d.budget <= 9999999))
            && (!('answers' in d) || (d.answers is map && d.answers.size() <= 10))
            && d.userId == request.auth.uid
            && d.category is string && d.sector is string
            && validLocation(d.location) && d.city is string
            && d.fileUrl is string && d.thumbUrl is string && d.fileName is string
            && (d.mediaType in ['image', 'video']
                || (d.mediaType == 'none' && d.fileUrl == '' && d.thumbUrl == '' && d.fileName == ''))
            && d.timestamp == request.time && d.is24 is bool && d.description is string
            && d.status == 'open' && d.takenBy == '' && d.takenByName == ''
            && d.confirmedByCompany == false && d.confirmedByUser == false;
      }
      function ownerUpdate() {
        let before = resource.data;
        let d = request.resource.data;
        let status = before.get('status', 'open');
        let photos = before.get('realizationStatus', '');
        return (onlyKeys(['description']) && d.description is string)
            // akceptacja oferty — w tym samym batchu oferta tej firmy dostaje 'accepted'
            || (onlyKeys(['takenBy', 'takenByName', 'confirmedByCompany', 'confirmedByUser',
                          'status', 'takenAt'])
                && status != 'taken' && photos == ''
                && d.status == 'taken' && d.takenBy is string && d.takenBy != ''
                && d.takenByName is string
                && d.confirmedByCompany == true && d.confirmedByUser == true
                && d.takenAt == request.time
                && getAfter(/databases/$(database)/documents/requests/$(requestId)/offers/$(d.takenBy)).data.status == 'accepted')
            // odblokowanie
            || (onlyKeys(['takenBy', 'takenByName', 'confirmedByCompany', 'confirmedByUser',
                          'status', 'realizationStatus'])
                && status == 'taken'
                && d.status == 'open' && d.takenBy == '' && d.takenByName == ''
                && d.confirmedByCompany == false && d.confirmedByUser == false
                && !('realizationStatus' in d))
            // ręczne zamknięcie
            || (onlyKeys(['status', 'closedAt', 'closedReason'])
                && status != 'closed'
                && d.status == 'closed' && d.closedReason == 'byUser' && d.closedAt == request.time)
            // decyzja o zdjęciach firmy
            || (status == 'taken' && photos == 'pending'
                && ((onlyKeys(['realizationStatus', 'status', 'closedReason', 'closedAt'])
                     && d.realizationStatus == 'approved' && d.status == 'closed'
                     && d.closedReason == 'realized' && d.closedAt == request.time)
                    || (onlyKeys(['realizationStatus']) && d.realizationStatus == 'rejected')));
      }
      function takerUpdate() {
        let photos = resource.data.get('realizationStatus', '');
        return resource.data.get('status', 'open') == 'taken'
            && onlyKeys(['realizationStatus'])
            && ((photos in ['', 'rejected'] && request.resource.data.realizationStatus == 'pending')
                || (photos in ['', 'pending'] && !('realizationStatus' in request.resource.data)));
      }

      // dokładne miejsce: klient i firma z przyjętą ofertą (takenBy); zgłoszenie ma tylko okolicę.
      // Zapis wyłącznie w batchu tworzącym zgłoszenie; starsze APK piszą dokładne location,
      // wtedy przenosi je funkcja hideRequestLocation.
      match /private/{docId} {
        allow get: if docId == 'location' && signedIn()
            && request.auth.uid in [get(/databases/$(database)/documents/requests/$(requestId)).data.userId,
                                    get(/databases/$(database)/documents/requests/$(requestId)).data.get('takenBy', '')];
        allow create: if docId == 'location' && signedIn()
            && !exists(/databases/$(database)/documents/requests/$(requestId))
            && getAfter(/databases/$(database)/documents/requests/$(requestId)).data.userId == request.auth.uid
            && validLocation(request.resource.data);
      }

      // oferta firmy (id = companyId): treść widzi tylko ta firma i właściciel zgłoszenia,
      // status zmienia wyłącznie właściciel zgłoszenia
      match /offers/{companyId} {
        allow get: if isMe(companyId) || isRequestOwner();
        allow list: if isRequestOwner();
        allow create: if isMe(companyId) && newOfferOk();
        allow update: if isRequestOwner() && onlyKeys(['status', 'decidedAt'])
            && request.resource.data.status in ['pending', 'maybe', 'accepted', 'rejected', 'closed']
            && (!('decidedAt' in changedKeys()) || request.resource.data.decidedAt == request.time);
        allow delete: if false;

        function parentRequest() {
          return get(/databases/$(database)/documents/requests/$(requestId)).data;
        }
        function isRequestOwner() {
          return signedIn() && parentRequest().userId == request.auth.uid;
        }
        function newOfferOk() {
          let d = request.resource.data;
          let r = parentRequest();
          // tylko konto firmowe, pod nazwą ze swojego profilu (przyjęcie oferty daje dostęp do telefonu klienta)
          let me = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
          return d.keys().hasOnly(['companyId', 'companyName', 'message', 'status', 'timestamp',
                  'price', 'priceTo', 'when'])
              && d.companyId == companyId && d.companyName is string && d.message is string
              && (!('price' in d) || (d.price is int && d.price >= 0 && d.price <= 999999))
              && (!('priceTo' in d) || ('price' in d && d.priceTo is int
                  && d.priceTo > d.price && d.priceTo <= 999999))
              && (!('when' in d) || d.when in ['today', 'tomorrow', 'week', 'agree'])
              && d.status == 'pending' && d.timestamp == request.time
              && me.get('firma', me.get('isCompany', false)) == true
              && d.companyName == me.get('companyName', '')
              && r.userId != request.auth.uid && r.get('status', 'open') == 'open';
        }
      }
    }

    // ── recenzje i komentarze: jedna recenzja na parę klient–firma, jeden komentarz na osobę ──
    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() && validReview(request.resource.data);
      allow update: if false;
      allow delete: if isMe(resource.data.userId);

      function validReview(d) {
        return d.keys().hasOnly(['userId', 'promoId', 'authorName', 'reviewedUserId', 'score',
                'fileUrl', 'thumbUrl', 'fileName', 'timestamp', 'description'])
            && d.userId == request.auth.uid
            && reviewId == request.auth.uid + '_' + d.reviewedUserId
            && d.reviewedUserId is string && d.reviewedUserId.size() > 0
            && d.reviewedUserId != request.auth.uid
            && d.score is int && d.score >= 1 && d.score <= 5
            && d.promoId is string && d.authorName is string && d.description is string
            && d.fileUrl is string && d.thumbUrl is string && d.fileName is string
            && d.timestamp == request.time;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && validComment(request.resource.data);
        allow update: if false;
        allow delete: if isMe(resource.data.authorId);

        // znaczek „właściciel” tylko dla firmy, której dotyczy recenzja
        function validComment(d) {
          return d.keys().hasOnly(['reviewId', 'authorId', 'authorName', 'isOwner', 'text', 'timestamp'])
              && d.reviewId == reviewId && d.authorId == request.auth.uid
              && commentId == request.auth.uid
              && d.authorName is string && d.text is string && d.text.size() > 0
              && d.timestamp == request.time
              && d.isOwner == (get(/databases/$(database)/documents/reviews/$(reviewId)).data.reviewedUserId == request.auth.uid);
        }
      }
    }

    // ── czat: chatId = posortowane "uidA_uidB"; uczestnictwo wynika z id ──
    // (okno nasłuchuje wiadomości, zanim powstanie dokument rozmowy)
    match /chats/{chatId} {
      allow get: if inChat(chatId);
      allow list: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if inChat(chatId) && chatId.split('_')[0] < chatId.split('_')[1]
          && chatWriteOk({});
      allow update: if inChat(chatId) && chatWriteOk(resource.data);
      allow delete: if false;

      // każdy wpisuje tylko swoją nazwę i flagę firmy, zeruje swój licznik,
      // rozmówcy dolicza dokładnie jedną wiadomość, do kosza wkłada tylko siebie
      function chatWriteOk(before) {
        let me = request.auth.uid;
        let pair = chatId.split('_');
        let other = pair[0] == me ? pair[1] : pair[0];
        let after = request.resource.data;
        let changed = after.diff(before).affectedKeys();
        let names = after.get('names', {}).diff(before.get('names', {})).affectedKeys();
        let flags = after.get('isCompany', {}).diff(before.get('isCompany', {})).affectedKeys();
        let u0 = before.get('unread', {});
        let u1 = after.get('unread', {});
        let unread = u1.diff(u0).affectedKeys();
        return pair.size() == 2 && pair[0] != pair[1]
            && changed.hasOnly(['participants', 'names', 'isCompany', 'lastMessage',
                                'lastTimestamp', 'unread', 'hiddenFor'])
            && after.participants.size() == 2 && after.participants.hasAll(pair)
            && names.hasOnly([me]) && (!(me in names) || after.names[me] is string)
            && flags.hasOnly([me]) && (!(me in flags) || after.isCompany[me] is bool)
            && unread.hasOnly([me, other])
            && (!(me in unread) || u1[me] == 0)
            && (!(other in unread) || u1[other] == u0.get(other, 0) + 1)
            && after.get('hiddenFor', []).toSet()
                   .difference(before.get('hiddenFor', []).toSet()).hasOnly([me])
            && (!('lastMessage' in changed) || after.lastMessage is string)
            && (!('lastTimestamp' in changed) || after.lastTimestamp == request.time);
      }

      match /messages/{messageId} {
        allow read: if inChat(chatId);
        allow create: if inChat(chatId) && !blockedByOther(chatId)
            && request.resource.data.keys().hasOnly(['from', 'content', 'timestamp', 'read'])
            && request.resource.data.from == request.auth.uid
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0
            && request.resource.data.timestamp == request.time
            && request.resource.data.read == false;
        // odbiorca oznacza przeczytane
        allow update: if inChat(chatId) && resource.data.from != request.auth.uid
            && onlyKeys(['read']) && request.resource.data.read == true;
        allow delete: if false;
      }
    }
    function inChat(chatId) {
      return signedIn() && request.auth.uid in chatId.split('_');
    }
    function blockedByOther(chatId) {
      let ids = chatId.split('_');
      let other = ids[0] == request.auth.uid ? ids[1] : ids[0];
      return exists(/databases/$(database)/documents/users/$(other)/blocked/$(request.auth.uid));
    }

    // ── zgłoszenia nadużyć: zapis tylko przez zgłaszającego, przegląd w konsoli ──
    match /reports/{reportId} {
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['reporterId', 'targetType', 'targetId',
                  'targetUserId', 'reason', 'details', 'createdAt', 'status'])
          && request.resource.data.reporterId == request.auth.uid
          && request.resource.data.targetType in ['promo', 'profile', 'review', 'chat', 'request']
          && request.resource.data.targetId is string && request.resource.data.targetId.size() > 0
          && request.resource.data.targetUserId is string
          && request.resource.data.reason is string && request.resource.data.reason.size() <= 100
          && request.resource.data.details is string && request.resource.data.details.size() <= 1000
          && request.resource.data.createdAt == request.time
          && request.resource.data.status == 'new';
      allow read, update, delete: if false;
    }

    // ── realizacje (zdjęcia Przed/Po) ──
    match /realizations/{realizationId} {
      allow read: if signedIn();
      // firma realizująca (czeka na potwierdzenie) albo właściciel zgłoszenia („od siebie”)
      allow create: if signedIn() && newRealizationOk(request.resource.data);
      // klient potwierdza/odrzuca czekające zdjęcia firmy, firma publikuje zdjęcia klienta
      allow update: if (isMe(resource.data.userId)
              && resource.data.get('addedByRole', 'company') != 'user'
              && resource.data.get('status', 'approved') == 'pending'
              && onlyKeys(['status', 'decidedAt'])
              && request.resource.data.status in ['approved', 'rejected']
              && request.resource.data.decidedAt == request.time)
          || (isMe(resource.data.companyId)
              && resource.data.get('addedByRole', 'company') == 'user'
              && onlyKeys(['publishedByCompany'])
              && request.resource.data.publishedByCompany is bool);
      allow delete: if isMe(resource.data.companyId) || isMe(resource.data.userId);

      function newRealizationOk(d) {
        let r = get(/databases/$(database)/documents/requests/$(d.requestId)).data;
        return d.keys().hasOnly(['companyId', 'requestId', 'userId', 'category', 'imageUrl',
                'beforeUrl', 'addedByRole', 'status', 'publishedByCompany', 'timestamp'])
            && d.category is string && d.imageUrl is string
            && (!('beforeUrl' in d) || d.beforeUrl is string)
            && d.publishedByCompany == false && d.timestamp == request.time
            && d.companyId is string && d.companyId != ''
            && r.userId == d.userId && r.takenBy == d.companyId
            && ((d.addedByRole == 'company' && d.companyId == request.auth.uid
                    && d.status == 'pending' && r.status == 'taken')
                || (d.addedByRole == 'user' && d.userId == request.auth.uid
                    && d.status == 'approved'));
      }
    }

    // ── powiadomienia (dzwonek): pisze backend, czyta i odczytuje właściciel ──
    match /notifications/{notifId} {
      allow read: if isMe(resource.data.userId);
      // oznaczenie nieistniejącego wpisu (np. chat_{ja}_{rozmówca}) kończy się
      // NOT_FOUND, które apka ignoruje — update nie może utworzyć dokumentu
      allow update: if signedIn()
          && (resource == null
              || (resource.data.userId == request.auth.uid && onlyKeys(['read'])
                  && request.resource.data.read == true));
      allow create: if false;
      allow delete: if isMe(resource.data.userId);
    }

    // ── tylko Cloud Functions ──
    match /reviewReminders/{id} {
      allow read, write: if false;
    }
  }
}
