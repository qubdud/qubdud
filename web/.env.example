# Skopiuj do .env.local i uzupełnij danymi aplikacji WEB z konsoli Firebase
# (Ustawienia projektu → Twoje aplikacje → aplikacja internetowa → konfiguracja SDK).
# apiKey i appId aplikacji web są inne niż w apce Android/iOS — nie przepisuj ich z firebase_options.dart.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=qubdud-8f2b8.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=qubdud-8f2b8
VITE_FIREBASE_STORAGE_BUCKET=qubdud-8f2b8.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=25035113178
VITE_FIREBASE_APP_ID=

# Opcjonalnie: App Check (reCAPTCHA Enterprise) — wymagane, jeśli w konsoli włączone jest wymuszanie App Check.
VITE_APPCHECK_RECAPTCHA_ENTERPRISE_KEY=

# Lokalnie na emulatorach (npm run emulators): ustaw true i VITE_FIREBASE_PROJECT_ID=demo-qubdud.
VITE_USE_EMULATORS=false
VITE_EMULATOR_HOST=127.0.0.1
VITE_AUTH_EMULATOR_PORT=9199
VITE_FIRESTORE_EMULATOR_PORT=8185
VITE_STORAGE_EMULATOR_PORT=9299
