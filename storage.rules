rules_version = '2';

// Pliki (filmy, zdjęcia, miniatury): pojedynczy plik czyta każdy (feed widzą też anonimy),
// listowania nie ma. Upload tylko pod własnym uid: files/{uid}, thumbs/{uid},
// realizations/{uid} — nowy obiekt z limitem rozmiaru i typu, bez nadpisywania.
service firebase.storage {
  match /b/{bucket}/o {
    function isImage(maxMb) {
      return request.resource.contentType.matches('image/.*')
          && request.resource.size <= maxMb * 1024 * 1024;
    }
    function isVideo(maxMb) {
      return request.resource.contentType.matches('video/.*')
          && request.resource.size <= maxMb * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow get: if true;
    }

    match /{folder}/{uid}/{name} {
      allow create: if request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.auth.uid == uid
          && ((folder == 'files' && (isImage(25) || isVideo(200)))
              || (folder == 'thumbs' && isImage(10))
              || (folder == 'realizations' && isImage(25)));
      allow delete: if request.auth != null && request.auth.uid == uid
          && folder in ['files', 'thumbs', 'realizations'];
    }
  }
}
